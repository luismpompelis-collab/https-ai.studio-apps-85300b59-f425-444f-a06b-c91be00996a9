rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isBootstrapAdmin() {
      return isSignedIn() && request.auth.token.email != null &&
        request.auth.token.email_verified == true &&
        request.auth.token.email.lower() == 'luismpompelis@gmail.com';
    }

    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && (
        isBootstrapAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserDoc().role == 'admin' && getUserDoc().active == true)
      );
    }

    function isSupervisor() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserDoc().role == 'supervisor' && getUserDoc().active == true;
    }

    function isValidPresence(data, userId) {
      return data.keys().hasAll(['uid', 'fullName', 'role', 'isOnline', 'lastSeenAt']) &&
        data.keys().hasOnly(['uid', 'fullName', 'role', 'isOnline', 'lastSeenAt']) &&
        data.uid is string && data.uid == userId && data.uid == request.auth.uid &&
        data.fullName is string && data.fullName.size() > 0 && data.fullName.size() <= 150 &&
        data.role in ['admin', 'supervisor', 'seller'] &&
        data.isOnline is bool &&
        data.lastSeenAt == request.time;
    }

    // Connection testing
    match /test/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (isAdmin() || request.auth.uid == userId);
      allow update: if isSignedIn() && (isAdmin() || request.auth.uid == userId);
      allow delete: if isAdmin();
    }

    // Clients Collection
    match /clients/{clientId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        isSupervisor() ||
        (resource.data.sellerId == request.auth.uid)
      );
      allow create: if isSignedIn() && (
        request.resource.data.sellerId == request.auth.uid || isAdmin()
      );
      allow update: if isSignedIn() && (
        isAdmin() ||
        (resource.data.sellerId == request.auth.uid) ||
        (isSupervisor() && resource.data.supervisorId == request.auth.uid)
      );
      allow delete: if isAdmin() || (isSignedIn() && resource.data.sellerId == request.auth.uid);
    }

    // Audit Logs Collection (Append-only)
    match /audit_logs/{logId} {
      allow read: if isAdmin() || isSupervisor();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // Real-time Team Presence Collection
    match /presence/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isSignedIn() && isValidId(userId) &&
        request.auth.uid == userId &&
        isValidPresence(request.resource.data, userId) && (
          isBootstrapAdmin() ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
           request.resource.data.role == getUserDoc().role)
        );
      allow delete: if isAdmin() && isValidId(userId);
    }
  }
}
