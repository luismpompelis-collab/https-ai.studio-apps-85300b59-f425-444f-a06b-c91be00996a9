rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isBootstrapAdmin() {
      return isSignedIn() && request.auth.token.email != null &&
        request.auth.token.email_verified == true &&
        request.auth.token.email.lower() == 'luismpompelis@gmail.com';
    }

    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && (
        isBootstrapAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserDoc().role == 'admin' && getUserDoc().active == true)
      );
    }

    function isActiveSeller() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserDoc().role == 'seller' &&
        getUserDoc().active == true;
    }

    function isValidPresence(data, userId) {
      return data.keys().hasAll(['uid', 'fullName', 'role', 'isOnline', 'lastSeenAt']) &&
        data.keys().hasOnly(['uid', 'fullName', 'role', 'isOnline', 'lastSeenAt']) &&
        data.uid is string && data.uid == userId && data.uid == request.auth.uid &&
        data.fullName is string && data.fullName.size() > 0 && data.fullName.size() <= 150 &&
        data.role in ['admin', 'seller'] &&
        data.isOnline is bool &&
        data.lastSeenAt == request.time;
    }

    // Connection testing
    match /test/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Users Collection (PII restricted to owner or Admin)
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (isAdmin() || request.auth.uid == userId);
      allow list: if isAdmin();
      allow create: if isSignedIn() && isValidId(userId) && (
        isAdmin() ||
        (request.auth.uid == userId &&
         request.resource.data.uid == userId &&
         request.resource.data.role == 'seller' &&
         request.resource.data.active == true)
      );
      allow update: if isSignedIn() && isValidId(userId) && (
        isAdmin() ||
        (request.auth.uid == userId &&
         request.resource.data.uid == resource.data.uid &&
         request.resource.data.role == resource.data.role &&
         request.resource.data.active == resource.data.active)
      );
      allow delete: if isAdmin() && isValidId(userId);
    }

    // Seller Invites Collection (Admin creates, Seller claims matching email on Google Sign-In)
    match /seller_invites/{inviteId} {
      allow get: if isSignedIn() && isValidId(inviteId) && (
        isAdmin() ||
        (request.auth.token.email != null &&
         resource.data.email == request.auth.token.email.lower())
      );
      allow list: if isAdmin();
      allow create, update: if isAdmin() && isValidId(inviteId) &&
        request.resource.data.email is string &&
        request.resource.data.fullName is string &&
        request.resource.data.role == 'seller' &&
        request.resource.data.active is bool;
      allow delete: if isAdmin() && isValidId(inviteId);
    }

    // Clients Collection (Direct Admin <-> Seller ownership)
    match /clients/{clientId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        resource.data.sellerId == request.auth.uid
      );
      allow create: if isSignedIn() && (
        isAdmin() ||
        (isActiveSeller() && request.resource.data.sellerId == request.auth.uid)
      );
      allow update: if isSignedIn() && (
        isAdmin() ||
        (isActiveSeller() &&
         resource.data.sellerId == request.auth.uid &&
         request.resource.data.sellerId == resource.data.sellerId)
      );
      allow delete: if isAdmin() || (isActiveSeller() && resource.data.sellerId == request.auth.uid);
    }

    // Audit Logs Collection (Append-only)
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // Real-time Admin <-> Seller Presence Collection
    match /presence/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (
        request.auth.uid == userId ||
        isAdmin() ||
        resource.data.role == 'admin'
      );
      allow list: if isSignedIn() && (
        isAdmin() ||
        resource.data.role == 'admin'
      );
      allow create, update: if isSignedIn() && isValidId(userId) &&
        request.auth.uid == userId &&
        isValidPresence(request.resource.data, userId) && (
          isBootstrapAdmin() ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
           request.resource.data.role == getUserDoc().role)
        );
      allow delete: if isAdmin() && isValidId(userId);
    }
  }
}
