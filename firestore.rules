rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isBootstrapAdmin() {
      return isSignedIn() && request.auth.token.email != null &&
        request.auth.token.email.lower() == 'luismpompelis@gmail.com';
    }

    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && (
        isBootstrapAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserDoc().role == 'admin' && getUserDoc().active == true)
      );
    }

    function isSupervisor() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserDoc().role == 'supervisor' && getUserDoc().active == true;
    }

    // Connection testing
    match /test/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (isAdmin() || request.auth.uid == userId);
      allow update: if isSignedIn() && (isAdmin() || request.auth.uid == userId);
      allow delete: if isAdmin();
    }

    // Clients Collection
    match /clients/{clientId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        isSupervisor() ||
        (resource.data.sellerId == request.auth.uid)
      );
      allow create: if isSignedIn() && (
        request.resource.data.sellerId == request.auth.uid || isAdmin()
      );
      allow update: if isSignedIn() && (
        isAdmin() ||
        (resource.data.sellerId == request.auth.uid) ||
        (isSupervisor() && resource.data.supervisorId == request.auth.uid)
      );
      allow delete: if isAdmin() || (isSignedIn() && resource.data.sellerId == request.auth.uid);
    }

    // Audit Logs Collection (Append-only)
    match /audit_logs/{logId} {
      allow read: if isAdmin() || isSupervisor();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }
  }
}
